@{
    ViewData["Title"] = "Nyx Insights Dashboard";
}

<style>
    .nyx-dashboard {
        max-width: 1100px;
        margin: 30px auto;
        padding: 0 20px;
        color: #243047;
    }

    .nyx-card {
        background: white;
        border: 1px solid #e1e6ed;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .nyx-header {
        margin-bottom: 28px;
    }

    .nyx-muted {
        color: #667085;
        line-height: 1.6;
    }

    .nyx-form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-top: 20px;
    }

    .nyx-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .nyx-field label {
        font-weight: 600;
    }

    .nyx-field input {
        padding: 10px;
        border: 1px solid #cbd2dc;
        border-radius: 7px;
    }

    .nyx-section-title {
        margin-top: 28px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e1e6ed;
        font-weight: 700;
    }

    .nyx-button {
        border: none;
        border-radius: 8px;
        padding: 13px 20px;
        margin-top: 22px;
        font-weight: 600;
        cursor: pointer;
    }

    .nyx-primary {
        background: #3158a6;
        color: white;
    }

    .nyx-primary:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .nyx-results {
        display: none;
    }

    .nyx-score-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .nyx-score {
        background: #f8faff;
        border: 1px solid #e1e6ed;
        padding: 22px;
        border-radius: 10px;
    }

    .nyx-score-value {
        font-size: 32px;
        font-weight: 700;
        margin-top: 8px;
    }

    .nyx-error {
        display: none;
        background: #fff0f0;
        border: 1px solid #e5b5b5;
        color: #8c2525;
        padding: 14px;
        margin-top: 18px;
        border-radius: 8px;
        white-space: pre-wrap;
    }

    .nyx-success {
        display: none;
        background: #eefbf3;
        border: 1px solid #aad7ba;
        color: #225c36;
        padding: 14px;
        margin-top: 18px;
        border-radius: 8px;
    }

    .nyx-explanation {
        white-space: pre-wrap;
        line-height: 1.7;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
    }

    .history-table th,
    .history-table td {
        padding: 10px;
        border-bottom: 1px solid #e1e6ed;
        text-align: left;
    }

    @@media (max-width: 760px) {
        .nyx-form-grid {
            grid-template-columns: 1fr;
        }

        .nyx-score-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="nyx-dashboard">

    <header class="nyx-header">

        <h1>Nyx Insights</h1>

        <p class="nyx-muted">
            Enter wearable health data to generate stress and
            next-night sleep predictions.
        </p>

    </header>


    <section class="nyx-card">

        <h2>Enter Your Wearable Data</h2>

        <form id="predictionForm"
              onsubmit="return false;">


            <div class="nyx-section-title">
                Heart Rate and Wellness
            </div>


            <div class="nyx-form-grid">

                <div class="nyx-field">

                    <label for="bpm">
                        Heart Rate (BPM)
                    </label>

                    <input id="bpm"
                           name="bpm"
                           type="number"
                           step="any"
                           required />

                </div>


                <div class="nyx-field">

                    <label for="mindfulness_session">
                        Mindfulness Session
                    </label>

                    <input id="mindfulness_session"
                           name="mindfulness_session"
                           type="number"
                           step="any"
                           required />

                </div>


                <div class="nyx-field">

                    <label for="exertion_points_percentage">
                        Exertion Points Percentage
                    </label>

                    <input id="exertion_points_percentage"
                           name="exertion_points_percentage"
                           type="number"
                           step="any"
                           required />

                </div>

            </div>


            <div class="nyx-section-title">
                Daily Activity
            </div>


            <div class="nyx-form-grid">

                <div class="nyx-field">
                    <label>Very Active Minutes</label>

                    <input name="very_active_minutes"
                           type="number"
                           step="any"
                           required />
                </div>


                <div class="nyx-field">
                    <label>Moderately Active Minutes</label>

                    <input name="moderately_active_minutes"
                           type="number"
                           step="any"
                           required />
                </div>


                <div class="nyx-field">
                    <label>Lightly Active Minutes</label>

                    <input name="lightly_active_minutes"
                           type="number"
                           step="any"
                           required />
                </div>


                <div class="nyx-field">
                    <label>Sedentary Minutes</label>

                    <input name="sedentary_minutes"
                           type="number"
                           step="any"
                           required />
                </div>


                <div class="nyx-field">
                    <label>Steps</label>

                    <input name="steps"
                           type="number"
                           step="any"
                           required />
                </div>


                <div class="nyx-field">
                    <label>Calories</label>

                    <input name="calories"
                           type="number"
                           step="any"
                           required />
                </div>

            </div>


            <div class="nyx-section-title">
                Heart Rate Zone Minutes
            </div>


            <div class="nyx-form-grid">

                <div class="nyx-field">
                    <label>Zone 1 Minutes</label>

                    <input name="minutes_in_default_zone_1"
                           type="number"
                           step="any"
                           required />
                </div>


                <div class="nyx-field">
                    <label>Zone 2 Minutes</label>

                    <input name="minutes_in_default_zone_2"
                           type="number"
                           step="any"
                           required />
                </div>


                <div class="nyx-field">
                    <label>Zone 3 Minutes</label>

                    <input name="minutes_in_default_zone_3"
                           type="number"
                           step="any"
                           required />
                </div>

            </div>

            <button id="analyzeButton"
                    type="button"
                    class="nyx-button nyx-primary">

                Analyze My Health Data

            </button>


            <p id="loadingMessage"
               class="nyx-muted"
               hidden>

                Analyzing...

            </p>


            <div id="errorMessage"
                 class="nyx-error">
            </div>


            <div id="saveMessage"
                 class="nyx-success">
            </div>

        </form>

    </section>


    <section id="resultsSection"
             class="nyx-results">


        <div class="nyx-card">

            <h2>Your Prediction Results</h2>


            <div class="nyx-score-grid">

                <div class="nyx-score">

                    <div>
                        Estimated Stress Score
                    </div>

                    <div id="stressScore"
                         class="nyx-score-value">

                        --

                    </div>

                </div>


                <div class="nyx-score">

                    <div>
                        Next-Night Sleep Efficiency
                    </div>

                    <div id="sleepScore"
                         class="nyx-score-value">

                        --

                    </div>

                </div>

            </div>

        </div>


        <div class="nyx-card">

            <h2>AI Health Data Analysis</h2>

            <div id="explanation"
                 class="nyx-explanation">

            </div>

        </div>


        <div class="nyx-card">

            <h2>Model Performance</h2>

            <div id="performanceMetrics">
            </div>

        </div>

    </section>


    <section class="nyx-card">

        <h2>Your Prediction History</h2>

        <p class="nyx-muted">
            Saved predictions for your logged-in account.
        </p>

        <div id="historyStatus">
            Loading history...
        </div>

        <div style="overflow-x: auto;">

            <table id="historyTable"
                   class="history-table"
                   hidden>

                <thead>

                    <tr>
                        <th>Date</th>
                        <th>BPM</th>
                        <th>Steps</th>
                        <th>Stress</th>
                        <th>Sleep Efficiency</th>
                    </tr>

                </thead>

                <tbody id="historyBody">
                </tbody>

            </table>

        </div>

    </section>

</div>


<script>

    console.log("NYX dashboard JavaScript loaded.");


    const predictionForm =
        document.getElementById("predictionForm");

    const analyzeButton =
        document.getElementById("analyzeButton");

    const loadingMessage =
        document.getElementById("loadingMessage");

    const errorMessage =
        document.getElementById("errorMessage");

    const saveMessage =
        document.getElementById("saveMessage");

    const resultsSection =
        document.getElementById("resultsSection");


    // notallow normal HTML form submission.

    predictionForm.addEventListener(
        "submit",
        function (event)
        {
            event.preventDefault();
            return false;
        });


    // Analyze button does not submit form.

    analyzeButton.addEventListener(
        "click",
        analyzeHealthData);


    async function analyzeHealthData()
    {
        errorMessage.style.display =
            "none";

        saveMessage.style.display =
            "none";

        resultsSection.style.display =
            "none";


        if (!predictionForm.reportValidity())
        {
            return;
        }


        analyzeButton.disabled =
            true;

        analyzeButton.textContent =
            "Analyzing...";

        loadingMessage.hidden =
            false;


        try
        {
            // Build JSON object from the 12  inputs.

            const formData =
                new FormData(predictionForm);

            const features =
                {};


            for (const [name, value]
                of formData.entries())
            {
                const number =
                    Number(value);


                if (!Number.isFinite(number))
                {
                    throw new Error(
                        `Invalid number for ${name}.`);
                }


                features[name] =
                    number;
            }


            console.log(
                "Sending prediction request:",
                features);


            // Send to ASP.NET.

            const response =
                await fetch(
                    "/api/predictions/predict-and-explain",
                    {
                        method: "POST",

                        headers:
                        {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(features)
                    });


            // Read text first so debugging works even
            // when server doesn't return valid JSON.

            const responseText =
                await response.text();


            console.log(
                "HTTP status:",
                response.status);


            console.log(
                "Raw response:",
                responseText);


            let data;


            try
            {
                data =
                    JSON.parse(responseText);
            }
            catch
            {
                throw new Error(
                    "Server returned something other than JSON:\n" +
                    responseText);
            }


            if (!response.ok)
            {
                throw new Error(
                    data.error ??
                    "Prediction request failed.");
            }


            // Response structure:
            // {
            //   predictionId: ...,
            //   predictionResult: {...},
            //   explanation: "..."
            // }

            const predictionResult =
                data.predictionResult;


            if (!predictionResult)
            {
                throw new Error(
                    "predictionResult was missing from server response.");
            }


            const predictions =
                predictionResult.predictions;


            if (!predictions)
            {
                throw new Error(
                    "predictions was missing from Azure ML response.");
            }


            // Show prediction values.

            document
                .getElementById("stressScore")
                .textContent =

                Number(
                    predictions.stress_score
                ).toFixed(2);


            document
                .getElementById("sleepScore")
                .textContent =

                Number(
                    predictions.sleep_efficiency_next_night
                ).toFixed(2) + "%";


            document
                .getElementById("explanation")
                .textContent =

                data.explanation ??
                "No AI explanation was returned.";


            displayPerformance(
                predictionResult.model_performance);


            resultsSection.style.display =
                "block";


            // Show confirmation that PostgreSQL saved it.

            saveMessage.textContent =
                `Prediction saved successfully. ` +
                `Database ID: ${data.predictionId}`;


            saveMessage.style.display =
                "block";


            // Reload history immediately.

            await loadHistory();


            resultsSection.scrollIntoView(
                {
                    behavior: "smooth",
                    block: "start"
                });
        }
        catch (error)
        {
            console.error(
                "Prediction error:",
                error);


            errorMessage.textContent =
                error.message ??
                "Unexpected prediction error.";


            errorMessage.style.display =
                "block";
        }
        finally
        {
            analyzeButton.disabled =
                false;


            analyzeButton.textContent =
                "Analyze My Health Data";


            loadingMessage.hidden =
                true;
        }
    }



    // History

    async function loadHistory()
    {
        const historyStatus =
            document.getElementById(
                "historyStatus");

        const historyTable =
            document.getElementById(
                "historyTable");

        const historyBody =
            document.getElementById(
                "historyBody");


        try
        {
            const response =
                await fetch(
                    "/api/predictions/history");


            const text =
                await response.text();


            if (!response.ok)
            {
                throw new Error(text);
            }


            const history =
                JSON.parse(text);


            historyBody.replaceChildren();


            if (history.length === 0)
            {
                historyStatus.textContent =
                    "No saved predictions yet.";

                historyTable.hidden =
                    true;

                return;
            }


            historyStatus.textContent =
                `${history.length} saved prediction(s).`;


            historyTable.hidden =
                false;


            for (const item of history)
            {
                const row =
                    document.createElement("tr");


                appendCell(
                    row,
                    new Date(
                        item.createdAt
                    ).toLocaleString());


                appendCell(
                    row,
                    Number(
                        item.bpm
                    ).toFixed(0));


                appendCell(
                    row,
                    Number(
                        item.steps
                    ).toFixed(0));


                appendCell(
                    row,
                    Number(
                        item.stressScore
                    ).toFixed(2));


                appendCell(
                    row,
                    Number(
                        item.sleepEfficiencyNextNight
                    ).toFixed(2) + "%");


                historyBody.appendChild(
                    row);
            }
        }
        catch (error)
        {
            console.error(
                "History loading failed:",
                error);


            historyStatus.textContent =
                "Could not load prediction history.";


            historyTable.hidden =
                true;
        }
    }


    function appendCell(row, value)
    {
        const cell =
            document.createElement("td");

        cell.textContent =
            value;

        row.appendChild(
            cell);
    }


    // display model performance

    function displayPerformance(performance)
    {
        const container =
            document.getElementById(
                "performanceMetrics");


        container.replaceChildren();


        if (!performance)
        {
            container.textContent =
                "Model performance information was not returned.";

            return;
        }


        const table =
            document.createElement("table");


        table.className =
            "history-table";


        const header =
            document.createElement("tr");


        [
            "Metric",
            "Stress Model",
            "Sleep Model"

        ].forEach(label =>
        {
            const th =
                document.createElement("th");

            th.textContent =
                label;

            header.appendChild(
                th);
        });


        table.appendChild(
            header);


        const rows =
        [
            [
                "Evaluation samples",
                "n"
            ],

            [
                "MAE",
                "mae"
            ],

            [
                "Baseline MAE",
                "baseline_mae"
            ],

            [
                "R²",
                "r2"
            ]
        ];


        for (const [label, key] of rows)
        {
            const row =
                document.createElement("tr");


            appendCell(
                row,
                label);


            appendCell(
                row,
                formatMetric(
                    performance.stress?.[key]));


            appendCell(
                row,
                formatMetric(
                    performance.sleep?.[key]));


            table.appendChild(
                row);
        }


        container.appendChild(
            table);
    }


    function formatMetric(value)
    {
        if (
            value === undefined ||
            value === null
        )
        {
            return "N/A";
        }


        if (
            typeof value === "number" &&
            !Number.isInteger(value)
        )
        {
            return value.toFixed(3);
        }


        return String(value);
    }



    // Load history as soon as dashboard opens.

    loadHistory();

</script>
