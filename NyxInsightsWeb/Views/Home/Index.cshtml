<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const manualTab = document.getElementById("nyx-manual-tab");
    const googleTab = document.getElementById("nyx-google-tab");
    const manualPanel = document.getElementById("nyx-manual-panel");
    const googlePanel = document.getElementById("nyx-google-panel");

    function selectHealthInput(mode) {
        const googleSelected = mode === "google";
        manualPanel.hidden = googleSelected;
        googlePanel.hidden = !googleSelected;
        manualTab.setAttribute("aria-selected", String(!googleSelected));
        googleTab.setAttribute("aria-selected", String(googleSelected));
        manualTab.tabIndex = googleSelected ? -1 : 0;
        googleTab.tabIndex = googleSelected ? 0 : -1;

        if (googleSelected) {
            loadGoogleHealthStatus();
        }
    }

    async function loadGoogleHealthStatus() {
        const status = document.getElementById("googleHealthStatus");
        const actions = document.getElementById("googleHealthConnectActions");
        const syncPanel = document.getElementById("googleHealthSyncPanel");
        const link = document.getElementById("googleHealthConnectLink");
        const label = link ? link.querySelector("span") : null;

        if (!status || !actions || !link || !label) return;

        status.hidden = false;
        status.classList.remove("is-connected");
        status.textContent = "Checking Google Health connection...";
        actions.hidden = true;
        if (syncPanel) syncPanel.hidden = true;

        try {
            const response = await fetch("/googlehealth/status", {
                method: "GET",
                credentials: "same-origin",
                cache: "no-store",
                headers: {
                    "Accept": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (response.status === 401 || response.redirected) {
                status.textContent = "Please sign in to your NYX account first.";
                return;
            }

            if (!response.ok) {
                throw new Error(`Connection status request failed (${response.status}).`);
            }

            const data = await response.json();

            if (data.connected) {
                status.classList.add("is-connected");
                if (syncPanel) syncPanel.hidden = false;
                status.textContent = data.accessTokenExpired
                    ? "Google Health connected. Your access token will be renewed automatically when you request health data."
                    : "Google Health connected";
                return;
            }

            status.textContent = data.needsReconnect
                ? "Your previous Google Health authorization needs to be renewed."
                : "Google Health is not connected to this NYX account yet.";

            label.textContent = data.needsReconnect
                ? "Reconnect with Google"
                : "Connect with Google";

            actions.hidden = false;
        } catch (error) {
            console.error("Google Health status check failed:", error);
            status.textContent = "Unable to check Google Health connection. Refresh the page and try again.";
        }
    }

    const googleSyncButton = document.getElementById("googleSyncButton");
    const googleSyncDate = document.getElementById("googleSyncEndDate");
    const googleSyncFeedback = document.getElementById("googleSyncFeedback");
    const googleSyncResults = document.getElementById("googleSyncResults");

    function currentLocalDate() {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const day = String(now.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
    }

    if (googleSyncDate) {
        googleSyncDate.value = currentLocalDate();
        googleSyncDate.max = currentLocalDate();
    }

    async function syncGoogleSteps() {
        if (!googleSyncButton || !googleSyncDate || !googleSyncFeedback || !googleSyncResults)
            return;

        const date = googleSyncDate.value;
        if (!date || date > currentLocalDate()) {
            googleSyncFeedback.hidden = false;
            googleSyncFeedback.classList.add("is-error");
            googleSyncFeedback.textContent = "Select a valid date that is not in the future.";
            return;
        }

        const csrfToken = document.querySelector(
            '#googleHealthSyncPanel input[name="__RequestVerificationToken"]');
        if (!csrfToken) {
            googleSyncFeedback.hidden = false;
            googleSyncFeedback.classList.add("is-error");
            googleSyncFeedback.textContent = "Security token missing. Reload the dashboard and retry.";
            return;
        }

        googleSyncButton.disabled = true;
        googleSyncButton.classList.add("is-loading");
        document.getElementById("googleSyncButtonLabel").textContent = "Syncing...";
        googleSyncResults.hidden = true;
        googleSyncFeedback.hidden = false;
        googleSyncFeedback.classList.remove("is-error");
        googleSyncFeedback.textContent = "Retrieving available records from Google Health...";

        try {
            const response = await fetch(
                `/googlehealth/sync-steps?endDate=${encodeURIComponent(date)}`, {
                method: "POST",
                credentials: "same-origin",
                cache: "no-store",
                headers: {
                    "Accept": "application/json",
                    "RequestVerificationToken": csrfToken.value
                }
            });
            const raw = await response.text();
            let data;
            try { data = JSON.parse(raw); } catch { data = null; }

            if (!response.ok) {
                if (response.status === 401) {
                    await loadGoogleHealthStatus();
                    throw new Error("Your Google Health authorization needs renewal. Reconnect with Google.");
                }
                throw new Error((data && data.error) ||
                    `Google Health synchronization failed (HTTP ${response.status}).`);
            }
            if (!data || !Array.isArray(data.history))
                throw new Error("Unexpected response from the synchronization endpoint.");

            document.getElementById("googleDaysWithData").textContent =
                `${data.daysWithData} / ${data.daysRequested}`;
            document.getElementById("googleLatestSteps").textContent =
                data.latestSteps == null ? "No data" :
                Number(data.latestSteps).toLocaleString();
            document.getElementById("googleTotalSteps").textContent =
                Number(data.totalSteps).toLocaleString();

            const rows = document.getElementById("googleSyncRows");
            rows.replaceChildren();
            for (const item of [...data.history].reverse()) {
                const tr = document.createElement("tr");
                const dayCell = document.createElement("td");
                const stepsCell = document.createElement("td");
                dayCell.textContent = item.date;
                stepsCell.textContent = Number(item.steps).toLocaleString();
                tr.append(dayCell, stepsCell);
                rows.appendChild(tr);
            }
            if (data.history.length === 0) {
                const tr = document.createElement("tr");
                const cell = document.createElement("td");
                cell.colSpan = 2;
                cell.textContent = "No step measurements were returned for this date range.";
                tr.appendChild(cell);
                rows.appendChild(tr);
            }

            googleSyncFeedback.textContent =
                `Sync complete. ${data.daysWithData} day(s) contained step records; ` +
                `${data.missingDates.length} day(s) had no available records.`;
            googleSyncResults.hidden = false;
            await loadGoogleHealthStatus();
        } catch (error) {
            googleSyncFeedback.classList.add("is-error");
            googleSyncFeedback.textContent = error.message || "Synchronization failed.";
        } finally {
            googleSyncButton.disabled = false;
            googleSyncButton.classList.remove("is-loading");
            document.getElementById("googleSyncButtonLabel").textContent = "Sync Health Data";
        }
    }

    if (googleSyncButton) googleSyncButton.addEventListener("click", syncGoogleSteps);

    if (manualTab && googleTab && manualPanel && googlePanel) {
        manualTab.addEventListener("click", () => selectHealthInput("manual"));
        googleTab.addEventListener("click", () => selectHealthInput("google"));
        [manualTab, googleTab].forEach(tab => {
            tab.addEventListener("keydown", event => {
                if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
                event.preventDefault();
                const nextTab = tab === manualTab ? googleTab : manualTab;
                selectHealthInput(nextTab === googleTab ? "google" : "manual");
                nextTab.focus();
            });
        });
        selectHealthInput("manual");
    }

    console.log(
        "NYX dashboard JavaScript loaded."
    );

    const predictionForm =
        document.getElementById(
            "predictionForm");

    const analyzeButton =
        document.getElementById(
            "analyzeButton");

    const loadingMessage =
        document.getElementById(
            "loadingMessage");

    const errorMessage =
        document.getElementById(
            "errorMessage");

    const saveMessage =
        document.getElementById(
            "saveMessage");

    const resultsSection =
        document.getElementById(
            "resultsSection");

    const trendsSection =
        document.getElementById(
            "trendsSection");

    //
    // Stored so old Chart.js instances can be destroyed before
    // rebuilding after another prediction.
    let stressChart =
        null;

    let sleepChart =
        null;

    let activityChart =
        null;

    predictionForm.addEventListener(
        "submit",
        function (event)
        {
            event.preventDefault();

            return false;
        });

    analyzeButton.addEventListener(
        "click",
        analyzeHealthData);

    async function analyzeHealthData()
    {
        errorMessage.style.display =
            "none";

        saveMessage.style.display =
            "none";

        resultsSection.style.display =
            "none";

        // Browser built-in required-field validation.

        if (!predictionForm.reportValidity())
        {
            return;
        }

        analyzeButton.disabled =
            true;

        analyzeButton.textContent =
            "Analyzing...";

        loadingMessage.hidden =
            false;

        try
        {
            // Convert form inputs into JSON numeric features.
            const formData =
                new FormData(
                    predictionForm);

            const features =
                {};

            for (const [name, value]
                of formData.entries())
            {
                const numericValue =
                    Number(value);

                if (!Number.isFinite(
                        numericValue))
                {
                    throw new Error(
                        `Invalid value entered for ${name}.`);
                }

                features[name] =
                    numericValue;
            }

            console.log(
                "Prediction request:",
                features);

            // ASP.NET endpoint:
            //
            // Azure ML
            // → Foundry
            // → PostgreSQL
            const response =
                await fetch(
                    "/api/predictions/predict-and-explain",
                    {
                        method:
                            "POST",

                        headers:
                        {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(
                                features)
                    });

            const responseText =
                await response.text();

            console.log(
                "Prediction status:",
                response.status);

            console.log(
                "Prediction response:",
                responseText);

            let data;

            try
            {
                data =
                    JSON.parse(
                        responseText);
            }
            catch
            {
                throw new Error(
                    "The server returned an invalid response.");
            }

            if (!response.ok)
            {
                throw new Error(
                    data.error ??
                    "Prediction request failed.");
            }

            // Extract prediction
            const predictionResult =
                data.predictionResult;

            if (!predictionResult)
            {
                throw new Error(
                    "Prediction result was missing.");
            }

            const predictions =
                predictionResult.predictions;

            if (!predictions)
            {
                throw new Error(
                    "Prediction values were missing.");
            }

            document
                .getElementById(
                    "stressScore")
                .textContent =

                Number(
                    predictions.stress_score
                ).toFixed(2);

            document
                .getElementById(
                    "sleepScore")
                .textContent =

                Number(
                    predictions
                        .sleep_efficiency_next_night
                ).toFixed(2) + "%";

            document
                .getElementById(
                    "explanation")
                .textContent =

                data.explanation ??
                "No explanation was returned.";

            displayPerformance(
                predictionResult
                    .model_performance);

            resultsSection.style.display =
                "block";

            saveMessage.textContent =
                `Prediction saved successfully. ` +
                `History ID: ${data.predictionId}`;

            saveMessage.style.display =
                "block";

            // Reload database history and refresh all charts.
            await loadHistory();

            resultsSection.scrollIntoView(
                {
                    behavior:
                        "smooth",

                    block:
                        "start"
                });
        }
        catch (error)
        {
            console.error(
                "NYX prediction error:",
                error);

            errorMessage.textContent =
                error.message ??
                "Something went wrong.";

            errorMessage.style.display =
                "block";
        }
        finally
        {
            analyzeButton.disabled =
                false;

            analyzeButton.textContent =
                "Analyze My Health Data";

            loadingMessage.hidden =
                true;
        }
    }

    async function loadHistory()
    {
        const historyStatus =
            document.getElementById(
                "historyStatus");

        const historyTableWrap =
            document.getElementById(
                "historyTableWrap");

        const historyBody =
            document.getElementById(
                "historyBody");

        historyStatus.textContent =
            "Loading prediction history...";

        try
        {
            const response =
                await fetch(
                    "/api/predictions/history",
                    {
                        method:
                            "GET",

                        headers:
                        {
                            "Accept":
                                "application/json"
                        }
                    });

            const responseText =
                await response.text();

            console.log(
                "History HTTP status:",
                response.status);

            console.log(
                "History response:",
                responseText);

            if (!response.ok)
            {
                throw new Error(
                    `History request failed: HTTP ${response.status}`);
            }

            const history =
                JSON.parse(
                    responseText);

            historyBody.replaceChildren();

            if (!history ||
                history.length === 0)
            {
                historyStatus.textContent =
                    "No saved predictions yet.";

                historyTableWrap.hidden =
                    true;

                trendsSection.style.display =
                    "none";

                destroyCharts();

                return;
            }

            historyStatus.textContent =
                `${history.length} saved prediction(s)`;

            historyTableWrap.hidden =
                false;

            // History endpoint currently returns newest first.

            for (const item of history)
            {
                const row =
                    document.createElement(
                        "tr");

                appendCell(
                    row,
                    formatTableDate(
                        item.createdAt));

                appendCell(
                    row,
                    formatWholeNumber(
                        item.bpm));

                appendCell(
                    row,
                    formatWholeNumber(
                        item.steps));

                appendCell(
                    row,
                    formatWholeNumber(
                        item.calories));

                appendCell(
                    row,
                    Number(
                        item.stressScore
                    ).toFixed(2));

                appendCell(
                    row,
                    Number(
                        item.sleepEfficiencyNextNight
                    ).toFixed(2) + "%");

                historyBody.appendChild(
                    row);
            }

            renderTrendCharts(
                history);
        }
        catch (error)
        {
            console.error(
                "History error:",
                error);

            historyStatus.textContent =
                "Could not load prediction history.";

            historyTableWrap.hidden =
                true;

            trendsSection.style.display =
                "none";
        }
    }

    function renderTrendCharts(history)
    {
        if (!history ||
            history.length === 0)
        {
            trendsSection.style.display =
                "none";

            return;
        }

        if (typeof Chart === "undefined")
        {
            console.error(
                "Chart.js did not load.");

            return;
        }

        trendsSection.style.display =
            "block";

        // Database returns newest first.
        //
        // Charts should visually move:
        //
        // Oldest to newest
        const chronological =
            [...history].sort(
                (a, b) =>
                    new Date(
                        a.createdAt) -
                    new Date(
                        b.createdAt)
            );

        const latest =
            chronological[
                chronological.length - 1];

        const latestAiExplanation =
 	    document.getElementById( "latestAiExplanation");

	if (latest.aiExplanation && latest.aiExplanation.trim() !== ""){
    		latestAiExplanation.textContent = latest.aiExplanation;
	}
	else{
    		latestAiExplanation.textContent ="No AI explanation was saved for the latest prediction.";
	}

        document
            .getElementById(
                "latestStress")
            .textContent =

            Number(
                latest.stressScore
            ).toFixed(2);

        document
            .getElementById(
                "latestSleep")
            .textContent =

            Number(
                latest.sleepEfficiencyNextNight
            ).toFixed(1) + "%";

        document
            .getElementById(
                "latestSteps")
            .textContent =

            Number(
                latest.steps
            ).toLocaleString();

        document
            .getElementById(
                "latestBpm")
            .textContent =

            Number(
                latest.bpm
            ).toFixed(0);

        const labels =
            chronological.map(
                item =>
                    formatChartDate(
                        item.createdAt)
            );

        const stressValues =
            chronological.map(
                item =>
                    Number(
                        item.stressScore)
            );

        const sleepValues =
            chronological.map(
                item =>
                    Number(
                        item.sleepEfficiencyNextNight)
            );

        const stepValues =
            chronological.map(
                item =>
                    Number(
                        item.steps)
            );

        const bpmValues =
            chronological.map(
                item =>
                    Number(
                        item.bpm)
            );

        destroyCharts();

        const stressCanvas =
            document.getElementById(
                "stressTrendChart");

        const stressContext =
            stressCanvas.getContext(
                "2d");

        const stressGradient =
            stressContext
                .createLinearGradient(
                    0,
                    0,
                    0,
                    320);

        stressGradient.addColorStop(
            0,
            "rgba(92, 107, 192, 0.30)");

        stressGradient.addColorStop(
            1,
            "rgba(92, 107, 192, 0.02)");

        stressChart =
            new Chart(
                stressContext,
                {
                    type:
                        "line",

                    data:
                    {
                        labels:
                            labels,

                        datasets:
                        [
                            {
                                label:
                                    "Stress score",

                                data:
                                    stressValues,

                                borderColor:
                                    "#5968c4",

                                backgroundColor:
                                    stressGradient,

                                fill:
                                    true,

                                borderWidth:
                                    2.5,

                                tension:
                                    0.38,

                                pointRadius:
                                    4,

                                pointHoverRadius:
                                    7,

                                pointBackgroundColor:
                                    "#ffffff",

                                pointBorderColor:
                                    "#5968c4",

                                pointBorderWidth:
                                    2
                            }
                        ]
                    },

                    options:
                        createModernChartOptions(
                            "Stress Score")
                });

        const sleepCanvas =
            document.getElementById(
                "sleepTrendChart");

        const sleepContext =
            sleepCanvas.getContext(
                "2d");

        const sleepGradient =
            sleepContext
                .createLinearGradient(
                    0,
                    0,
                    0,
                    320);

        sleepGradient.addColorStop(
            0,
            "rgba(44, 160, 133, 0.28)");

        sleepGradient.addColorStop(
            1,
            "rgba(44, 160, 133, 0.02)");

        sleepChart =
            new Chart(
                sleepContext,
                {
                    type:
                        "line",

                    data:
                    {
                        labels:
                            labels,

                        datasets:
                        [
                            {
                                label:
                                    "Sleep efficiency",

                                data:
                                    sleepValues,

                                borderColor:
                                    "#2d9c82",

                                backgroundColor:
                                    sleepGradient,

                                fill:
                                    true,

                                borderWidth:
                                    2.5,

                                tension:
                                    0.38,

                                pointRadius:
                                    4,

                                pointHoverRadius:
                                    7,

                                pointBackgroundColor:
                                    "#ffffff",

                                pointBorderColor:
                                    "#2d9c82",

                                pointBorderWidth:
                                    2
                            }
                        ]
                    },

                    options:
                    {
                        ...createModernChartOptions(
                            "Sleep Efficiency"),

                        scales:
                        {
                            x:
                                createXAxis(),

                            y:
                            {
                                min:
                                    0,

                                max:
                                    100,

                                border:
                                {
                                    display:
                                        false
                                },

                                grid:
                                {
                                    color:
                                        "rgba(148, 163, 184, 0.12)"
                                },

                                title:
                                {
                                    display:
                                        true,

                                    text:
                                        "Sleep Efficiency (%)",

                                    color:
                                        "#748095",

                                    font:
                                    {
                                        size:
                                            11
                                    }
                                },

                                ticks:
                                {
                                    color:
                                        "#7a8495",

                                    padding:
                                        8,

                                    callback:
                                        value =>
                                            value + "%"
                                }
                            }
                        }
                    }
                });

        const activityCanvas =
            document.getElementById(
                "activityTrendChart");

        const activityContext =
            activityCanvas.getContext(
                "2d");

        activityChart =
            new Chart(
                activityContext,
                {
                    type:
                        "line",

                    data:
                    {
                        labels:
                            labels,

                        datasets:
                        [
                            {
                                label:
                                    "Steps",

                                data:
                                    stepValues,

                                yAxisID:
                                    "ySteps",

                                borderColor:
                                    "#d48b39",

                                backgroundColor:
                                    "rgba(212, 139, 57, 0.10)",

                                borderWidth:
                                    2.5,

                                tension:
                                    0.35,

                                pointRadius:
                                    4,

                                pointHoverRadius:
                                    7,

                                pointBackgroundColor:
                                    "#ffffff",

                                pointBorderColor:
                                    "#d48b39",

                                pointBorderWidth:
                                    2
                            },

                            {
                                label:
                                    "Heart Rate (BPM)",

                                data:
                                    bpmValues,

                                yAxisID:
                                    "yBpm",

                                borderColor:
                                    "#d75f73",

                                backgroundColor:
                                    "rgba(215, 95, 115, 0.10)",

                                borderWidth:
                                    2.5,

                                tension:
                                    0.35,

                                pointRadius:
                                    4,

                                pointHoverRadius:
                                    7,

                                pointBackgroundColor:
                                    "#ffffff",

                                pointBorderColor:
                                    "#d75f73",

                                pointBorderWidth:
                                    2
                            }
                        ]
                    },

                    options:
                    {
                        responsive:
                            true,

                        maintainAspectRatio:
                            false,

                        animation:
                        {
                            duration:
                                650
                        },

                        interaction:
                        {
                            mode:
                                "index",

                            intersect:
                                false
                        },

                        plugins:
                        {
                            legend:
                            {
                                display:
                                    true,

                                position:
                                    "top",

                                align:
                                    "end",

                                labels:
                                {
                                    usePointStyle:
                                        true,

                                    pointStyle:
                                        "circle",

                                    boxWidth:
                                        8,

                                    padding:
                                        18,

                                    color:
                                        "#5d687a",

                                    font:
                                    {
                                        size:
                                            12
                                    }
                                }
                            },

                            tooltip:
                            {
                                backgroundColor:
                                    "#1f2937",

                                titleColor:
                                    "#ffffff",

                                bodyColor:
                                    "#e5e7eb",

                                padding:
                                    12,

                                cornerRadius:
                                    9,

                                displayColors:
                                    true
                            }
                        },

                        scales:
                        {
                            x:
                                createXAxis(),

                            ySteps:
                            {
                                type:
                                    "linear",

                                position:
                                    "left",

                                beginAtZero:
                                    true,

                                border:
                                {
                                    display:
                                        false
                                },

                                grid:
                                {
                                    color:
                                        "rgba(148, 163, 184, 0.12)"
                                },

                                title:
                                {
                                    display:
                                        true,

                                    text:
                                        "Steps",

                                    color:
                                        "#748095",

                                    font:
                                    {
                                        size:
                                            11
                                    }
                                },

                                ticks:
                                {
                                    color:
                                        "#7a8495",

                                    callback:
                                        value =>
                                            Number(
                                                value)
                                                .toLocaleString()
                                }
                            },

                            yBpm:
                            {
                                type:
                                    "linear",

                                position:
                                    "right",

                                beginAtZero:
                                    false,

                                border:
                                {
                                    display:
                                        false
                                },

                                grid:
                                {
                                    drawOnChartArea:
                                        false
                                },

                                title:
                                {
                                    display:
                                        true,

                                    text:
                                        "BPM",

                                    color:
                                        "#748095",

                                    font:
                                    {
                                        size:
                                            11
                                    }
                                },

                                ticks:
                                {
                                    color:
                                        "#7a8495"
                                }
                            }
                        }
                    }
                });
    }

    function createModernChartOptions(
        yAxisTitle)
    {
        return {
            responsive:
                true,

            maintainAspectRatio:
                false,

            animation:
            {
                duration:
                    650,

                easing:
                    "easeOutQuart"
            },

            interaction:
            {
                mode:
                    "index",

                intersect:
                    false
            },

            plugins:
            {
                legend:
                {
                    display:
                        true,

                    position:
                        "top",

                    align:
                        "end",

                    labels:
                    {
                        usePointStyle:
                            true,

                        pointStyle:
                            "circle",

                        boxWidth:
                            8,

                        padding:
                            18,

                        color:
                            "#5d687a",

                        font:
                        {
                            size:
                                12
                        }
                    }
                },

                tooltip:
                {
                    enabled:
                        true,

                    backgroundColor:
                        "#1f2937",

                    titleColor:
                        "#ffffff",

                    bodyColor:
                        "#e5e7eb",

                    padding:
                        12,

                    cornerRadius:
                        9,

                    displayColors:
                        true
                }
            },

            scales:
            {
                x:
                    createXAxis(),

                y:
                {
                    beginAtZero:
                        false,

                    border:
                    {
                        display:
                            false
                    },

                    grid:
                    {
                        color:
                            "rgba(148, 163, 184, 0.12)"
                    },

                    title:
                    {
                        display:
                            true,

                        text:
                            yAxisTitle,

                        color:
                            "#748095",

                        font:
                        {
                            size:
                                11
                        }
                    },

                    ticks:
                    {
                        color:
                            "#7a8495",

                        padding:
                            8
                    }
                }
            }
        };
    }

    function createXAxis()
    {
        return {
            border:
            {
                display:
                    false
            },

            grid:
            {
                display:
                    false
            },

            ticks:
            {
                color:
                    "#7a8495",

                maxRotation:
                    0,

                autoSkip:
                    true,

                maxTicksLimit:
                    7,

                padding:
                    8
            }
        };
    }

    function destroyCharts()
    {
        if (stressChart)
        {
            stressChart.destroy();

            stressChart =
                null;
        }

        if (sleepChart)
        {
            sleepChart.destroy();

            sleepChart =
                null;
        }

        if (activityChart)
        {
            activityChart.destroy();

            activityChart =
                null;
        }
    }

    function displayPerformance(
        performance)
    {
        const container =
            document.getElementById(
                "performanceMetrics");

        container.replaceChildren();

        if (!performance)
        {
            container.textContent =
                "Model performance information is unavailable.";

            return;
        }

        const table =
            document.createElement(
                "table");

        table.className =
            "performance-table";

        const header =
            document.createElement(
                "tr");

        [
            "Metric",
            "Stress Model",
            "Sleep Model"

        ].forEach(
            label =>
            {
                const th =
                    document.createElement(
                        "th");

                th.textContent =
                    label;

                header.appendChild(
                    th);
            });

        table.appendChild(
            header);

        const rows =
        [
            [
                "Evaluation Samples",
                "n"
            ],

            [
                "Mean Absolute Error",
                "mae"
            ],

            [
                "Baseline MAE",
                "baseline_mae"
            ],

            [
                "R² Score",
                "r2"
            ]
        ];

        for (const [label, key]
            of rows)
        {
            const row =
                document.createElement(
                    "tr");

            appendCell(
                row,
                label);

            appendCell(
                row,
                formatMetric(
                    performance
                        .stress?.[key]));

            appendCell(
                row,
                formatMetric(
                    performance
                        .sleep?.[key]));

            table.appendChild(
                row);
        }

        container.appendChild(
            table);
    }

    function appendCell(
        row,
        value)
    {
        const cell =
            document.createElement(
                "td");

        cell.textContent =
            value;

        row.appendChild(
            cell);
    }

    function formatMetric(
        value)
    {
        if (value === undefined ||
            value === null)
        {
            return "N/A";
        }

        if (typeof value === "number" &&
            !Number.isInteger(value))
        {
            return value.toFixed(3);
        }

        return String(value);
    }

    function formatWholeNumber(
        value)
    {
        const number =
            Number(value);

        if (!Number.isFinite(number))
        {
            return "N/A";
        }

        return Math.round(
            number
        ).toLocaleString();
    }

    function formatChartDate(
        value)
    {
        const date =
            new Date(value);

        return date.toLocaleString(
            [],
            {
                month:
                    "short",

                day:
                    "numeric",

                hour:
                    "numeric",

                minute:
                    "2-digit"
            });
    }

    function formatTableDate(
        value)
    {
        const date =
            new Date(value);

        return date.toLocaleString(
            [],
            {
                year:
                    "numeric",

                month:
                    "short",

                day:
                    "numeric",

                hour:
                    "numeric",

                minute:
                    "2-digit"
            });
    }

    loadHistory();

</script>
