@{
    ViewData["Title"] = "Nyx Insights Dashboard";
}

<style>
    :root {
        --nyx-bg: #f5f7fb;
        --nyx-card: #ffffff;
        --nyx-border: #e5e9f0;
        --nyx-text: #172033;
        --nyx-muted: #6b7280;
        --nyx-primary: #4f67d9;
        --nyx-primary-dark: #354bb5;
        --nyx-success: #14855f;
        --nyx-danger: #b42318;
        --nyx-warning-bg: #fff9eb;
        --nyx-warning-border: #f0dda6;
    }

    body {
        background: var(--nyx-bg);
    }

    .nyx-dashboard {
        max-width: 1240px;
        margin: 34px auto 70px;
        padding: 0 22px;
        color: var(--nyx-text);
    }

    .nyx-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 28px;
    }

    .nyx-header h1 {
        margin: 0 0 7px;
        font-size: 32px;
        font-weight: 750;
        letter-spacing: -0.7px;
    }

    .nyx-header p {
        margin: 0;
    }

    .nyx-muted {
        color: var(--nyx-muted);
        line-height: 1.65;
    }

    .nyx-card {
        background: var(--nyx-card);
        border: 1px solid var(--nyx-border);
        border-radius: 18px;
        padding: 26px;
        margin-bottom: 24px;
        box-shadow:
            0 1px 2px rgba(16, 24, 40, 0.03),
            0 6px 22px rgba(16, 24, 40, 0.04);
    }

    .nyx-card h2 {
        margin: 0 0 7px;
        font-size: 21px;
        letter-spacing: -0.2px;
    }

    .nyx-section-title {
        margin-top: 28px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--nyx-border);
        font-size: 14px;
        font-weight: 700;
        color: #3e4b64;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .nyx-form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-top: 19px;
    }

    .nyx-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .nyx-field label {
        font-size: 14px;
        font-weight: 650;
    }

    .nyx-field small {
        font-size: 12px;
        color: var(--nyx-muted);
    }

    .nyx-field input {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #d5dae3;
        border-radius: 10px;
        padding: 12px 13px;
        font-size: 15px;
        background: #fbfcfe;
        transition:
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            background 0.15s ease;
    }

    .nyx-field input:focus {
        outline: none;
        border-color: #7689e7;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(79, 103, 217, 0.10);
    }

    .nyx-actions {
        margin-top: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .nyx-button {
        border: none;
        border-radius: 10px;
        padding: 13px 20px;
        font-size: 15px;
        font-weight: 650;
        cursor: pointer;
        transition:
            transform 0.12s ease,
            background 0.15s ease,
            box-shadow 0.15s ease;
    }

    .nyx-button:hover:not(:disabled) {
        transform: translateY(-1px);
    }

    .nyx-primary {
        color: #ffffff;
        background: var(--nyx-primary);
        box-shadow: 0 4px 12px rgba(79, 103, 217, 0.20);
    }

    .nyx-primary:hover:not(:disabled) {
        background: var(--nyx-primary-dark);
    }

    .nyx-primary:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .nyx-warning {
        margin-top: 20px;
        background: var(--nyx-warning-bg);
        border: 1px solid var(--nyx-warning-border);
        border-radius: 11px;
        padding: 14px 16px;
        line-height: 1.6;
        font-size: 13px;
    }

    .nyx-error,
    .nyx-success {
        display: none;
        margin-top: 18px;
        padding: 14px 16px;
        border-radius: 10px;
        line-height: 1.55;
    }

    .nyx-error {
        color: var(--nyx-danger);
        background: #fff4f2;
        border: 1px solid #f4c5be;
        white-space: pre-wrap;
    }

    .nyx-success {
        color: #166b4d;
        background: #effaf5;
        border: 1px solid #b9e3d0;
    }

    .nyx-results {
        display: none;
    }

    .nyx-score-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 22px;
    }

    .nyx-score {
        border: 1px solid var(--nyx-border);
        border-radius: 15px;
        padding: 23px;
        background: linear-gradient(
            145deg,
            #fafbff 0%,
            #f4f7ff 100%
        );
    }

    .nyx-score-label {
        color: var(--nyx-muted);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .nyx-score-value {
        font-size: 36px;
        font-weight: 760;
        letter-spacing: -1px;
        color: #304a9c;
    }

    .nyx-explanation {
        margin-top: 18px;
        line-height: 1.75;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .nyx-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 22px;
        margin-bottom: 30px;
    }

    .nyx-kpi {
        padding: 20px;
        border-radius: 15px;
        border: 1px solid var(--nyx-border);
        background: #fbfcff;
    }

    .nyx-kpi-label {
        color: var(--nyx-muted);
        font-size: 12px;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: 0.45px;
        margin-bottom: 10px;
    }

    .nyx-kpi-value {
        font-size: 28px;
        font-weight: 750;
        letter-spacing: -0.6px;
    }

    .nyx-kpi-subtitle {
        margin-top: 7px;
        color: var(--nyx-muted);
        font-size: 12px;
    }

    .nyx-chart-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .nyx-chart-card {
        border: 1px solid var(--nyx-border);
        border-radius: 16px;
        padding: 20px;
        background: #ffffff;
    }

    .nyx-chart-card-wide {
        grid-column: 1 / -1;
    }

    .nyx-chart-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 18px;
    }

    .nyx-chart-title {
        margin: 0 0 4px;
        font-size: 16px;
        font-weight: 700;
    }

    .nyx-chart-description {
        margin: 0;
        color: var(--nyx-muted);
        font-size: 12px;
        line-height: 1.5;
    }

    .nyx-chart-badge {
        flex-shrink: 0;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f1f4ff;
        color: #465bb8;
        font-size: 11px;
        font-weight: 650;
    }

    .nyx-chart-container {
        position: relative;
        width: 100%;
        height: 330px;
    }

    .nyx-chart-card-wide .nyx-chart-container {
        height: 360px;
    }

    .nyx-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--nyx-border);
        border-radius: 13px;
        margin-top: 18px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .history-table th {
        padding: 13px 15px;
        background: #f8f9fc;
        text-align: left;
        color: #536074;
        font-weight: 700;
        border-bottom: 1px solid var(--nyx-border);
        white-space: nowrap;
    }

    .history-table td {
        padding: 13px 15px;
        border-bottom: 1px solid #eef0f4;
        white-space: nowrap;
    }

    .history-table tbody tr:last-child td {
        border-bottom: none;
    }

    .history-table tbody tr:hover {
        background: #fafbfe;
    }

    .performance-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
        font-size: 14px;
    }

    .performance-table th,
    .performance-table td {
        padding: 12px;
        border-bottom: 1px solid var(--nyx-border);
        text-align: left;
    }

    .performance-table th {
        color: #556176;
    }

    @@media (max-width: 950px) {
        .nyx-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .nyx-form-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .nyx-chart-grid {
            grid-template-columns: 1fr;
        }

        .nyx-chart-card-wide {
            grid-column: auto;
        }

        .nyx-chart-container,
        .nyx-chart-card-wide .nyx-chart-container {
            height: 310px;
        }

        .nyx-score-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 560px) {
        .nyx-dashboard {
            padding: 0 12px;
            margin-top: 20px;
        }

        .nyx-card {
            padding: 18px;
            border-radius: 14px;
        }

        .nyx-form-grid,
        .nyx-kpi-grid {
            grid-template-columns: 1fr;
        }

        .nyx-header h1 {
            font-size: 27px;
        }
    }

    .nyx-input-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .nyx-mode-tab {
        border: 1px solid var(--nyx-border);
        border-radius: 10px;
        background: var(--nyx-card);
        color: var(--nyx-muted);
        padding: 12px 20px;
        font: inherit;
        font-weight: 650;
        cursor: pointer;
    }

    .nyx-mode-tab:hover {
        background: #f1f4ff;
    }

    .nyx-mode-tab[aria-selected="true"] {
        background: var(--nyx-primary);
        border-color: var(--nyx-primary);
        color: #fff;
    }

    .nyx-mode-tab:focus-visible,
    .nyx-google-connect:focus-visible {
        outline: 3px solid #93c5fd;
        outline-offset: 3px;
    }

    #nyx-manual-panel[hidden],
    #nyx-google-panel[hidden] {
        display: none !important;
    }

    .nyx-google-info {
        margin-top: 22px;
        padding: 18px 20px;
        border: 1px solid var(--nyx-border);
        border-radius: 12px;
        background: #f8faff;
    }

    .nyx-google-info h3 {
        margin: 0 0 12px;
        font-size: 16px;
    }

    .nyx-google-info ol {
        margin: 0;
        padding-left: 21px;
        color: var(--nyx-muted);
        line-height: 1.8;
    }

    .nyx-google-connect {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 50px;
        padding: 12px 20px;
        background: #ffffff;
        border: 1px solid #dadce0;
        border-radius: 10px;
        color: #202124;
        font-size: 15px;
        font-weight: 650;
        line-height: 1.2;
        text-decoration: none;
        box-shadow: 0 2px 5px rgba(23, 32, 51, 0.07);
    }

    .nyx-google-connect svg {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
    }

    .nyx-google-connect:hover {
        background: #f8faff;
        border-color: #b9c5e0;
        color: #202124;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(23, 32, 51, 0.10);
    }

    .nyx-google-connect:active {
        transform: translateY(0);
    }

    .nyx-google-note {
        margin-top: 18px;
        font-size: 13px;
    }

    .nyx-google-status {
        margin-top: 22px;
        padding: 13px 16px;
        border: 1px solid var(--nyx-border);
        border-radius: 10px;
        background: #f8faff;
        color: var(--nyx-muted);
        font-size: 14px;
        line-height: 1.5;
    }

    .nyx-google-status.is-connected {
        background: #effaf5;
        border-color: #b9e3d0;
        color: #166b4d;
    }

    .nyx-google-actions[hidden] {
        display: none !important;
    }

    .nyx-sync-card {
        margin-top: 24px;
        padding: 22px;
        border-radius: 16px;
        border: 1px solid #dbe3f5;
        background: linear-gradient(150deg, #ffffff 0%, #f6f8ff 100%);
    }

    .nyx-sync-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .nyx-sync-symbol {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        width: 44px;
        border-radius: 13px;
        background: #e9eeff;
        color: #405ad1;
    }

    .nyx-sync-heading h3 {
        font-size: 17px;
        margin: 0;
        font-weight: 750;
    }

    .nyx-sync-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: end;
    }

    .nyx-sync-date {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 0 0 auto;
    }

    .nyx-sync-date label {
        font-size: 13px;
        font-weight: 650;
        color: #43516a;
    }

    .nyx-sync-date input {
        border: 1px solid #cfd8ea;
        border-radius: 10px;
        padding: 12px 13px;
        font: inherit;
        font-size: 14px;
        background: white;
        color: #172033;
    }

    .nyx-sync-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 48px;
        padding: 12px 21px;
        border: 1px solid rgba(79, 103, 217, 0.46);
        border-radius: 12px;
        background: rgba(79, 103, 217, 0.045);
        color: #3c55bd;
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.2;
        cursor: pointer;
        box-shadow: 0 3px 12px rgba(41, 62, 145, 0.06);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: background 0.2s ease, border-color 0.2s ease,
                    color 0.2s ease, box-shadow 0.2s ease,
                    transform 0.2s ease;
    }

    .nyx-sync-button svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .nyx-sync-button:hover:not(:disabled) {
        background: rgba(79, 103, 217, 0.14);
        border-color: #5870d7;
        color: #3048b3;
        box-shadow: 0 8px 22px rgba(61, 81, 173, 0.13);
        transform: translateY(-1px);
    }

    .nyx-sync-button:active:not(:disabled) {
        background: rgba(79, 103, 217, 0.20);
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(61, 81, 173, 0.08);
    }

    .nyx-sync-button:disabled {
        cursor: progress;
        opacity: 0.68;
        transform: none;
        box-shadow: none;
    }

    .nyx-sync-button:focus-visible,
    .nyx-sync-date input:focus-visible {
        outline: 3px solid rgba(79, 103, 217, 0.35);
        outline-offset: 3px;
    }

    .nyx-sync-button.is-loading svg {
        animation: nyx-spin 0.9s linear infinite;
    }

    @@keyframes nyx-spin {
        to { transform: rotate(360deg); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .nyx-sync-button {
            transition: none;
        }

        .nyx-sync-button.is-loading svg {
            animation: none;
        }
    }

    .nyx-sync-feedback {
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.6;
        background: #ecf2ff;
        color: #334a91;
    }

    .nyx-sync-feedback.is-error {
        background: #fff4f2;
        color: #a3291b;
    }

    .nyx-sync-results {
        border-top: 1px solid #e3e8f3;
        margin-top: 19px;
        padding-top: 17px;
    }

    .nyx-sync-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin: 12px 0 18px;
    }

    .nyx-sync-stat {
        padding: 14px;
        border: 1px solid #e1e7f4;
        border-radius: 11px;
        background: #fff;
    }

    .nyx-sync-stat strong {
        display: block;
        font-size: 21px;
        color: #304a9c;
        margin-top: 6px;
    }

    .nyx-sync-table-wrap {
        max-height: 300px;
        overflow: auto;
        border: 1px solid #e1e7f4;
        border-radius: 11px;
        background: #fff;
    }

    .nyx-sync-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .nyx-sync-table th,
    .nyx-sync-table td {
        text-align: left;
        border-bottom: 1px solid #eef1f7;
        padding: 11px 14px;
    }

    .nyx-sync-table th {
        background: #f8faff;
        position: sticky;
        top: 0;
    }

    @@media (max-width: 600px) {
        .nyx-sync-controls { align-items: stretch; }
        .nyx-sync-date, .nyx-sync-button { width: 100%; }
        .nyx-sync-summary { grid-template-columns: 1fr; }
    }
</style>

<div class="nyx-dashboard">

    <header class="nyx-header">

        <div>
            <h1>Nyx Insights</h1>

            <p class="nyx-muted">
                AI-assisted stress and next-night sleep insights
                based on wearable health data.
            </p>
        </div>

    </header>

    <div class="nyx-input-tabs" role="tablist" aria-label="Health input method">
        <button type="button" id="nyx-manual-tab" class="nyx-mode-tab"
                role="tab" aria-selected="true" aria-controls="nyx-manual-panel">
            Manual Entry
        </button>
        <button type="button" id="nyx-google-tab" class="nyx-mode-tab"
                role="tab" aria-selected="false" aria-controls="nyx-google-panel" tabindex="-1">
            Google Health
        </button>
    </div>

    <section class="nyx-card" id="nyx-manual-panel" role="tabpanel"
             aria-labelledby="nyx-manual-tab" tabindex="0">

        <h2>Analyze Your Health Data</h2>

        <p class="nyx-muted">
            Enter the 12 features expected by the prediction model.
            Your analysis will automatically be saved to your account.
        </p>

        <form id="predictionForm"
              onsubmit="return false;">

            <div class="nyx-section-title">
                Heart Rate & Wellness
            </div>

            <div class="nyx-form-grid">

                <div class="nyx-field">

                    <label for="bpm">
                        Heart Rate (BPM)
                    </label>

                    <input id="bpm"
                           name="bpm"
                           type="number"
                           min="0"
                           max="300"
                           step="any"
                           placeholder="80"
                           required />

                    <small>Beats per minute</small>

                </div>

                <div class="nyx-field">

                    <label for="mindfulness_session">
                        Mindfulness Session
                    </label>

                    <input id="mindfulness_session"
                           name="mindfulness_session"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="0"
                           required />

                </div>

                <div class="nyx-field">

                    <label for="exertion_points_percentage">
                        Exertion Percentage
                    </label>

                    <input id="exertion_points_percentage"
                           name="exertion_points_percentage"
                           type="number"
                           min="0"
                           max="1"
                           step="any"
                           placeholder="0.75"
                           required />

                    <small>Decimal from 0 to 1</small>

                </div>

            </div>

            <div class="nyx-section-title">
                Daily Activity
            </div>

            <div class="nyx-form-grid">

                <div class="nyx-field">

                    <label>
                        Very Active Minutes
                    </label>

                    <input name="very_active_minutes"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="20"
                           required />

                </div>

                <div class="nyx-field">

                    <label>
                        Moderately Active Minutes
                    </label>

                    <input name="moderately_active_minutes"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="30"
                           required />

                </div>

                <div class="nyx-field">

                    <label>
                        Lightly Active Minutes
                    </label>

                    <input name="lightly_active_minutes"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="131"
                           required />

                </div>

                <div class="nyx-field">

                    <label>
                        Sedentary Minutes
                    </label>

                    <input name="sedentary_minutes"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="600"
                           required />

                </div>

                <div class="nyx-field">

                    <label>
                        Steps
                    </label>

                    <input name="steps"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="7389"
                           required />

                </div>

                <div class="nyx-field">

                    <label>
                        Calories
                    </label>

                    <input name="calories"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="2059"
                           required />

                </div>

            </div>

            <div class="nyx-section-title">
                Heart Rate Zones
            </div>

            <div class="nyx-form-grid">

                <div class="nyx-field">

                    <label>
                        Zone 1 Minutes
                    </label>

                    <input name="minutes_in_default_zone_1"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="123"
                           required />

                </div>

                <div class="nyx-field">

                    <label>
                        Zone 2 Minutes
                    </label>

                    <input name="minutes_in_default_zone_2"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="0"
                           required />

                </div>

                <div class="nyx-field">

                    <label>
                        Zone 3 Minutes
                    </label>

                    <input name="minutes_in_default_zone_3"
