@{
}

<div class="nyx-login-body">
    <div class="nyx-login-box">
        <div class="nyx-login-main">
            <form method="post" class="login-container">
                <div class="login-box">
                    <div class="login-head">Nyx Insights</div>

                    <div class="login-subhead">Sign in to your account.</div>

                    <div class="login-input-box">
                        <div class="login-input-head">Username:</div>
                        <input asp-for="username" type="text" class="login-input" id="username" />
                    </div>

                    <div class="login-input-box">
                        <div class="login-input-head">Password:</div>
                        <input asp-for="password" class="login-input" id="password" />
                    </div>
                </div>

                <button class="login-btn" id="login-btn" type="submit">
                    <div class="login-btn-txt">Login</div>
                </button>
            </form>
        </div>
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
